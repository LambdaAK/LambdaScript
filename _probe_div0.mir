entry: @main
fn main() -> unit {
entry:
  _t1 = div 1, 0
  _t2 = icmp eq %_t1, 1
  _t3 = and false, %_t2
  br %_t3 ? then_1 : else_2
then_1:

  br merge_3
else_2:

  br merge_3
merge_3:
  _t4 = phi i32 [ then_1, 1 ], [ else_2, 0 ]
  _t5 = indirect_call &ls_int_to_str : fn(i32) -> string(%_t4) -> string
  void indirect &ls_println : fn(string) -> unit(%_t5)
  ret void
}
