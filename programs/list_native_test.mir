entry: @main
fn sum(lst: list i32) -> i32 {
entry:
  _t1 = icmp eq %lst, nullptr
  br %_t1 ? swm_2 : swn_3
swm_2:

  br swm_1
swn_3:
  _t2 = icmp ne %lst, nullptr
  _t3 = list_head i32 %lst
  _t4 = list_tail i32 %lst
  br %_t2 ? swm_4 : swf_5
swm_4:
  _t5 = call @sum(%_t4)
  _t6 = add %_t3, %_t5
  br swm_1
swf_5:
  void call @abort()
  unreachable
swm_1:
  _t7 = phi i32 [ swm_2, 0 ], [ swm_4, %_t6 ]
  ret %_t7
}

fn main() -> unit {
entry:
  _t8 = list_nil i32
  br lrh_1
lrh_1:
  _t9 = phi i32 [ entry, 4 ], [ lrb_2, %_t11 ]
  _t10 = phi list i32 [ entry, %_t8 ], [ lrb_2, %_t12 ]
  _t13 = icmp sge %_t9, 0
  br %_t13 ? lrb_2 : lre_3
lrb_2:
  _t12 = list_cons(i32 head=%_t9 tail=%_t10)
  _t11 = sub %_t9, 1
  br lrh_1
lre_3:
  _t14 = call @sum(%_t10)
  _t15 = call @int_to_str(%_t14)
  void call @println(%_t15)
  _t16 = list_nil i32
  _t17 = list_cons(i32 head=4 tail=%_t16)
  _t18 = list_cons(i32 head=3 tail=%_t17)
  _t19 = list_cons(i32 head=2 tail=%_t18)
  _t20 = list_cons(i32 head=1 tail=%_t19)
  _t21 = list_cons(i32 head=0 tail=%_t20)
  _t22 = call @sum(%_t21)
  _t23 = call @int_to_str(%_t22)
  void call @println(%_t23)
  ret void
}
