// A small trait declared with the brace-oriented `inter` syntax, and two
// instances. (The prelude's own Show already covers the built-in types.)
inter Describe <a> {
  val describe : a -> String
}

impl Describe for Int where
  describe = int_to_str
end

impl Describe for Bool where
  describe = fn b -> if b then "yes" else "no"
end

let () = print_string (describe 42)
let () = print_string (describe true)
