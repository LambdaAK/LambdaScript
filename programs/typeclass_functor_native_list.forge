// Functor for built-in lists, used through a function that works for any
// Functor (here: lists and the prelude's Option).
impl Functor for [u] where
  fmap g xs =
    case xs do
    | [] -> []
    | h :: t -> g h :: fmap g t
end

let double_all xs = fmap (fn x -> x * 2) xs

let () = println (double_all [1, 2, 3])
let () = println (double_all (Some 21))
