entry: @main
fn foo(_p1: unit, _p2: unit) -> i1 {
entry:

  ret true
}

fn add(x: i32, y: i32, bb: i1) -> i32 {
entry:

  br %bb ? then_1 : else_2
then_1:
  _t1 = add %x, %y
  br merge_3
else_2:
  _t2 = sub %x, %y
  br merge_3
merge_3:
  _t3 = phi i32 [ then_1, %_t1 ], [ else_2, %_t2 ]
  ret %_t3
}

