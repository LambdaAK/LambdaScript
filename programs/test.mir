entry: @main
fn fact_helper__lsn1(n: i32, acc: i32) -> i32 {
entry:
  _t1 = icmp eq %n, 0
  br %_t1 ? then_1 : else_2
then_1:

  br merge_3
else_2:
  _t2 = sub %n, 1
  _t3 = mul %n, %acc
  _t4 = call @fact_helper__lsn1(%_t2, %_t3)
  br merge_3
merge_3:
  _t5 = phi i32 [ then_1, %acc ], [ else_2, %_t4 ]
  ret %_t5
}

fn fact(n: i32) -> i32 {
entry:
  _t6 = call @fact_helper__lsn1(%n, 1)
  ret %_t6
}

fn main() -> unit {
entry:
  _t7 = call @fact(5)
  _t8 = call @int_to_str(%_t7)
  void call @println(%_t8)
