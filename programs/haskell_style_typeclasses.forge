// Haskell-style typeclasses: the prelude's Show, Eq, Ord, Semigroup, Monoid
// and Functor traits implemented for user-defined types.

type Point = | Point of (Int, Int)

impl Show for Point where
  show p = case p do | Point (x, y) -> "<" ^ show x ^ ", " ^ show y ^ ">"
end

impl Eq for Point where
  (==) p q = case (p, q) do | (Point (a, b), Point (c, d)) -> a == c && b == d
end

// Points are ordered by x, then by y.
impl Ord for Point where
  compare p q =
    case (p, q) do
    | (Point (a, b), Point (c, d)) ->
        case compare a c do
        | EQ -> compare b d
        | o -> o
end

// Points add up coordinate-wise, with the origin as identity.
impl Semigroup for Point where
  mappend p q = case (p, q) do | (Point (a, b), Point (c, d)) -> Point (a + c, b + d)
  ,
  (++) p q = mappend p q
end

impl Monoid for Point where
  empty = Point (0, 0)
end

type Box<a> = | Box of a

impl Functor for Box where
  fmap f b = case b do | Box x -> Box (f x)
end

impl Show for Box<a> requires Show<a> where
  show b = case b do | Box x -> "Box(" ^ show x ^ ")"
end

// Works for any monoid.
let rec concat_all xs = case xs do | [] -> empty | h :: t -> h ++ concat_all t

let () = println (Point (1, 2))
let () = println (Point (1, 2) == Point (1, 2))
let () = println (compare (Point (1, 2)) (Point (1, 3)))
let () = println (concat_all [Point (1, 2), Point (3, 4), Point (5, 6)])
let () = println (concat_all ["ab", "cd"])
let () = println (fmap (fn x -> x * 2) (Box 21))
