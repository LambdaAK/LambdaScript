// A user-defined list type (independent of the built-in lists).
type rec MyList<a> =
  | Nil
  | Cons of (a, MyList<a>)

let nil = Nil
let singleton = Cons (1, Nil)
let list123 = Cons (1, Cons (2, Cons (3, Nil)))

let rec length lst =
  case lst do
  | Nil -> 0
  | Cons (_, t) -> 1 + length t

let () = println (length list123)

let rec sum lst =
  case lst do
  | Nil -> 0
  | Cons (h, t) -> h + sum t

let () = println (sum list123)
