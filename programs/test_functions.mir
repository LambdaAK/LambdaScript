entry: @main
fn add(x: i32, y: i32) -> i32 {
entry:
  _t1 = add %x, %y
  ret %_t1
}

fn factorial(n: i32) -> i32 {
entry:
  _t4 = icmp eq %n, 0
  br %_t4 ? then_1 : else_2
then_1:

  br merge_3
else_2:
  _t5 = sub %n, 1
  _t6 = call @factorial(%_t5)
  _t7 = mul %n, %_t6
  br merge_3
merge_3:
  _t8 = phi i32 [ then_1, 1 ], [ else_2, %_t7 ]
  ret %_t8
}

fn main() -> unit {
entry:
  _t2 = call @add(10, 20)
  result = %_t2
  _t3 = call @int_to_str(%result)
  void call @println(%_t3)
  _t9 = call @factorial(5)
  fact5 = %_t9
  _t10 = call @int_to_str(%fact5)
  void call @println(%_t10)
  ret void
}
