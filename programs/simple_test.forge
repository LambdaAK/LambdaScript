// A parameterised type alias.
type Pair<a> = (a, a)

let () = print_string "Testing Pair type..."

let int_pair : Pair<Int> = (5, 10)
let () = print_string "Created Int pair"

let get_first p = case p do | (x, _) -> x

let get_second p = case p do | (_, y) -> y

let first = get_first int_pair
let second = get_second int_pair

let () = println first
let () = println second

let () = print_string "Pair type works!"
