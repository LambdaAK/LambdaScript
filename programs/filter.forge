// filter keeps the elements of a list that satisfy a predicate.
let rec filter f arr =
  case arr do
  | [] -> []
  | h :: t -> if f h then h :: filter f t else filter f t

// Sum of the even numbers 1..100: prints 2550.
let () = println (reduce_left (fn acc -> fn x -> acc + x) 0 (filter (fn x -> x % 2 == 0) [1...100]))
