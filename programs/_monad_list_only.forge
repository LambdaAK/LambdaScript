// A user-defined list type with the prelude's Functor, Applicative and Monad
// instances (Monad requires Applicative, which requires Functor).
type rec MyList<a> =
  | Nil
  | Cons of (a, MyList<a>)

let rec append xs ys = case xs do | Nil -> ys | Cons (h, t) -> Cons (h, append t ys)

impl Functor for MyList where
  fmap f xs = case xs do | Nil -> Nil | Cons (h, t) -> Cons (f h, fmap f t)
end

impl Applicative for MyList where
  pure x = Cons (x, Nil)
  ,
  ap fs xs = case fs do | Nil -> Nil | Cons (f, rest) -> append (fmap f xs) (ap rest xs)
end

impl Monad for MyList where
  bind xs f = case xs do | Nil -> Nil | Cons (h, t) -> append (f h) (bind t f)
end

let rec to_list xs = case xs do | Nil -> [] | Cons (h, t) -> h :: to_list t

let pairs = Cons (1, Cons (2, Nil)) >>= (fn x -> Cons (x, Cons (x * 10, Nil)))
let () = println (to_list pairs)
