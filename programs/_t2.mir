entry: @main
fn sum(c: rawptr) -> i32 {
entry:
  _t1 = variant_tag %c
  _t2 = icmp eq %_t1, 0
  br %_t2 ? swm_2 : swn_3
swm_2:

  br swm_1
swn_3:
  _t3 = variant_tag %c
  _t4 = icmp eq %_t3, 1
  _t5 = variant_payload %c
  _t6 = heap_unbox (i32, rawptr) %_t5
  _t7 = tuple_proj %_t6[0] : i32,rawptr
  _t8 = tuple_proj %_t6[1] : i32,rawptr
  br %_t4 ? swm_4 : swf_5
swm_4:
  _t9 = call @sum(%_t8)
  _t10 = add %_t7, %_t9
  br swm_1
swf_5:
  void call @abort()
  unreachable
swm_1:
  _t11 = phi i32 [ swm_2, 0 ], [ swm_4, %_t10 ]
  ret %_t11
}

fn main() -> unit {
entry:
  _t12 = variant_mk 0 nullptr
  _t13 = tuple_pack [i32, rawptr] (20, %_t12)
  _t14 = heap_box (i32, rawptr) %_t13
  _t15 = variant_mk 1 %_t14
  _t16 = tuple_pack [i32, rawptr] (10, %_t15)
  _t17 = heap_box (i32, rawptr) %_t16
  _t18 = variant_mk 1 %_t17
  _t19 = call @sum(%_t18)
  _t20 = indirect_call &ls_int_to_str : fn(i32) -> string(%_t19) -> string
  void indirect &ls_println : fn(string) -> unit(%_t20)
