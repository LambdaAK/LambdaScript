// Option-based error handling with bind / >>=.
let parse_digit c =
  case c do
  | '0' -> Some 0 | '1' -> Some 1 | '2' -> Some 2 | '3' -> Some 3 | '4' -> Some 4
  | '5' -> Some 5 | '6' -> Some 6 | '7' -> Some 7 | '8' -> Some 8 | '9' -> Some 9
  | _ -> None

let rec parse_digits acc cs =
  case cs do
  | [] -> Some acc
  | c :: rest -> parse_digit c >>= (fn d -> parse_digits (acc * 10 + d) rest)

let parse_int s = if str_length s == 0 then None else parse_digits 0 (string_to_list s)

let safe_div a b = if b == 0 then None else Some (a / b)

let describe r =
  case r do
  | Some v -> "ok " ^ int_to_str v
  | None -> "error"

let compute a b = parse_int a >>= (fn x -> parse_int b >>= (fn y -> safe_div x y))

let () = print_string (describe (compute "84" "2"))
let () = print_string (describe (compute "84" "0"))
let () = print_string (describe (compute "8x" "2"))
let () = print_string (describe (compute "" "2"))
let () = print_string (describe (fmap (fn v -> v * 100) (compute "9" "3")))
let () = print_string (describe (compute "1" "2" <|> Some 7))
