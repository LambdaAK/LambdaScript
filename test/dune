(executable
 (name test)
 (public_name Test)
 (modules test)
 (libraries Language ounit2 str))

(test
 (name compiler_tests)
 (modules compiler_tests)
 (libraries Language ounit2 unix)
 (deps (source_tree compiler_cases))
 (action
  (chdir %{workspace_root} (run %{test}))))

