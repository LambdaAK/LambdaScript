entry: @main
fn main() -> unit {
entry:
  _t1 = and false, false
  br %_t1 ? then_1 : else_2
then_1:

  br merge_3
else_2:

  br merge_3
merge_3:
  _t2 = phi i32 [ then_1, 1 ], [ else_2, 0 ]
  _t3 = indirect_call &ls_int_to_str : fn(i32) -> string(%_t2) -> string
  void indirect &ls_println : fn(string) -> unit(%_t3)
  ret void
}
