// Random numbers and number formatting.

// A linear congruential generator (the constants of C's rand). The state is
// threaded explicitly: every draw returns the value and the next state.
// All products stay below 2^62, so both back ends compute the same numbers.
mod Rng where
  let next s = (1103515245 * s + 12345) % 2147483648

  // Uniform in [0, 1).
  let uniform s =
    let s1 = next s in
    (int_to_float s1 /. 2147483648.0, s1)

  // Uniform in [lo, hi).
  let between lo hi s =
    let (u, s1) = uniform s in
    (lo +. (hi -. lo) *. u, s1)

  // Approximately normal: the sum of twelve uniforms, minus six.
  let normal mu sigma s =
    let rec go k acc s =
      if k == 0 then (acc, s)
      else
        let (u, s1) = uniform s in
        go (k - 1) (acc +. u) s1
    in
    let (total, s1) = go 12 0.0 s in
    (mu +. sigma *. (total -. 6.0), s1)

  // n draws of gen, threading the state.
  let rec repeat n gen s =
    if n == 0 then ([], s)
    else
      let (x, s1) = gen s in
      let (xs, s2) = repeat (n - 1) gen s1 in
      (x :: xs, s2)
end

mod Fmt where
  let rec pow10 d = if d == 0 then 1 else 10 * pow10 (d - 1)

  let rec repeat_str k s = if k <= 0 then "" else s ^ repeat_str (k - 1) s
  let zeros k = repeat_str k "0"
  let spaces k = repeat_str k " "

  // x with d digits after the point, rounded half away from zero.
  let fixed d x =
    let p = pow10 d in
    let a = if x < 0.0 then 0.0 -. x else x in
    let n = float_to_int (a *. int_to_float p +. 0.5) in
    let frac = int_to_str (n % p) in
    let sign = if x < 0.0 && n > 0 then "-" else "" in
    if d == 0 then sign ^ int_to_str n
    else sign ^ int_to_str (n / p) ^ "." ^ zeros (d - str_length frac) ^ frac

  let percent x = fixed 1 (100.0 *. x) ^ "%"

  // s padded with spaces to width w.
  let left w s = s ^ spaces (w - str_length s)
  let right w s = spaces (w - str_length s) ^ s
end
