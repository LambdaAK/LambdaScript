// Missing feature: there is no builtin to turn a Char into its code or a
// String into an Int (library.tex lists only int_to_str, char_to_str,
// string_to_list, ...). Parsing numbers -- e.g. in the assembler -- needs a
// hand-written digit table (Fmt.digit_value / Fmt.parse_int in fmt.forge).
// Expected: something like char_code : Char -> Int and
//   string_to_int : String -> Option<Int> (or Int).
// Actual: error: type error: Unbound variable: char_code (both back ends).
// Run: ./_build/default/bin/interpreter.exe projects/systems/bugs/04-no-char-code.forge
let () = println (char_code '7' - char_code '0')
