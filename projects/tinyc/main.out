  optimised source:
    fn square(x: int): int {
      return x * x;
    }
    fn pick(flag: bool): int {
      if (flag) {
        return 20;
      } else {
        return 10;
      }
    }
    {
      var x: int = 10;
      print x;
      print square(7);
      print pick(true) + pick(false);
      print 0;
      print x;
      print x > 3;
    }
