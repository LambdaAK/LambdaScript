  optimised source:
    fn fact(n: int): int {
      if (n <= 1) {
        return 1;
      }
      return n * fact(n - 1);
    }
    fn fact_loop(n: int): int {
      var acc: int = 1;
      while (n > 1) {
        acc = acc * n;
        n = n - 1;
      }
      return acc;
    }
    {
      var i: int = 0;
      while (i <= 10) {
        print fact(i);
        i = i + 1;
      }
      print fact(20) == fact_loop(20);
    }
