// FIXED: the built-ins are char_to_int, int_to_char, str_to_int (an
// Option<Int>) and string_of_list; this file now uses those names.
// MISSING FEATURE: there is no way to turn a Char into its code or a digit
// string into an Int (no char_to_int / char_code / string_to_int /
// int_of_string in library.tex or among the built-ins in src/env.ml).
// Any lexer has to decode digits with a ten-way `case` (see
// Util.digit_value in util.forge), and arbitrary characters cannot be
// mapped to numbers at all.
//
// Expected: 7 and 123 (with some such built-ins).
// Actual:   error: type error: Unbound variable: char_to_int
//
// Run: ./_build/default/bin/interpreter.exe projects/tinyc/bugs/05-no-char-to-int.forge
let () = println (char_to_int '7' - char_to_int '0')
let () = println (str_to_int "123")
