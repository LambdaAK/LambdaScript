$ help
cat     print files (-n numbers lines)
echo    print the arguments
ls      list files (-l with sizes)
wc      count lines, words, bytes
grep    lines matching a regex
head    first n lines
tail    last n lines
sort    sort lines (-k key, -t sep)
uniq    collapse adjacent duplicates
cut     select fields
tr      translate or delete characters
rev     reverse each line
nl      number non-empty lines
sed     substitute: s/regex/text/[g]
column  align separated columns
table   draw a boxed table
stats   statistics of a numeric field
freq    most frequent words

aliases: ll = ls -l, count = wc -l, upper = tr a-z A-Z
pipes: a | b,  redirection: > file, >> file,  quotes: '...' "..."

$ ls -l
   847  people.csv
   828  server.log
   254  poem.txt
   425  calc.fl
    52  words.txt

$ cat -n poem.txt
     1  the river keeps no ledger of its stones
     2  it carries what it can and drops the rest
     3  the heron counts the minutes standing still
     4  the willow writes its name across the water
     5  and every evening light comes down to drink
     6  the river keeps no ledger of its stones

$ wc poem.txt calc.fl
      6     48    254 poem.txt
     14     98    425 calc.fl
     20    146    679 total

$ cat poem.txt | wc -lw
