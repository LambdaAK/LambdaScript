\RequirePackage[hidelinks]{hyperref}
\hypersetup{colorlinks=true,linkcolor=ForgeSteel,urlcolor=ForgeSteel,citecolor=ForgeSteel,
  pdftitle={Forge Reference Manual},pdfauthor={The Forge project}}
