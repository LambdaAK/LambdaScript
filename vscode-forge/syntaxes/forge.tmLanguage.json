{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Forge",
  "scopeName": "source.forge",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#storage"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#characters"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#type-constructors"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.forge",
          "begin": "\\(\\*",
          "end": "\\*\\)",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        },
        {
          "name": "comment.line.double-slash.forge",
          "begin": "//",
          "end": "$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.forge",
          "match": "\\b(if|then|else|case|do|of|switch)\\b"
        },
        {
          "name": "keyword.other.forge",
          "match": "\\b(let|in|and|fn|for|with|end|where|requires|enum|mod|use)\\b"
        }
      ]
    },
    "storage": {
      "patterns": [
        {
          "name": "storage.type.forge",
          "match": "\\b(type|rec|trait|inter|impl|val)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.forge",
          "match": "\\b(int|float|bool|string|char|unit|Int|Float|Bool|String|Char|Unit)\\b"
        },
        {
          "name": "support.type.custom.forge",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "support.type.variable.forge",
          "match": "'[a-z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.forge",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.unit.forge",
          "match": "\\(\\)"
        },
        {
          "name": "constant.other.wildcard.forge",
          "match": "\\b_\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.forge",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.forge",
              "match": "\\\\(n|t|r|\\\\|\"|')"
            }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.forge",
          "match": "'([^'\\\\]|\\\\(n|t|r|\\\\|\"|'))'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.forge",
          "match": "\\b-?[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.forge",
          "match": "\\b-?[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.forge",
          "match": "->"
        },
        {
          "name": "keyword.operator.switch.forge",
          "match": "=>"
        },
        {
          "name": "keyword.operator.bind.forge",
          "match": "<-"
        },
        {
          "name": "keyword.operator.pipeline.forge",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.range.forge",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.cons.forge",
          "match": "::"
        },
        {
          "name": "keyword.operator.comparison.forge",
          "match": "(==|!=|<>|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.forge",
          "match": "(&&|\\|\\|)"
        },
        {
          "name": "keyword.operator.arithmetic.forge",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.type-annotation.forge",
          "match": ":"
        },
        {
          "name": "keyword.operator.pipe.forge",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.assignment.forge",
          "match": "="
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.forge",
          "match": "\\b(print|println|int_to_str|int_to_float|float_to_int|string_to_list|map|filter|reduce_left|reduce_right|not)\\b"
        },
        {
          "name": "entity.name.function.forge",
          "match": "\\([^\\)]+\\)(?=\\s*:)"
        },
        {
          "name": "entity.name.function.forge",
          "match": "\\([^\\)]+\\)(?=\\s+[a-z_][a-zA-Z0-9_']*\\s*=)"
        },
        {
          "name": "entity.name.function.forge",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b(?=\\s*=)"
        }
      ]
    },
    "type-constructors": {
      "patterns": [
        {
          "name": "entity.name.type.constructor.forge",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.brackets.forge",
          "match": "[\\[\\]()]"
        },
        {
          "name": "punctuation.section.braces.forge",
          "match": "[{}]"
        },
        {
          "name": "punctuation.separator.comma.forge",
          "match": ","
        },
        {
          "name": "punctuation.terminator.semicolon.forge",
          "match": ";"
        }
      ]
    }
  }
}
